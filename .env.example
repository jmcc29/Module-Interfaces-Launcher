# Variables obligatorias del ambiente de desarrollo Compose.

# Comunicación servidor a servidor de los BFF con Gateway.
GATEWAY_INTERNAL_URL=http://gateway-service-dev:3000

# Origen público del Hub visto por el navegador.
HUB_PUBLIC_ORIGIN=http://localhost:3001

# Orígenes públicos usados por el Hub después de autorizar un lanzamiento.
BENEFICIARY_PUBLIC_ORIGIN=http://localhost:3002
SALES_PUBLIC_ORIGIN=http://localhost:3003
COLLECTIONS_PUBLIC_ORIGIN=http://localhost:3004

# Overrides opcionales. Si se omiten, Compose usa estos valores.
# LOGIN_HUB_PORT=3001
# BENEFICIARY_PORT=3002
# SALES_PORT=3003
# COLLECTIONS_PORT=3004
# AUTH_PENDING_TTL_SECONDS=600
# NEXT_PUBLIC_BIOMETRIC_PORT=8899
