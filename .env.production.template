# Variables obligatorias del launcher frontend para producción.

# URL HTTPS que los servidores Next.js usan para llamar al Gateway.
GATEWAY_INTERNAL_URL=https://gateway.example.test

# Origen HTTPS público y canónico del Hub.
HUB_PUBLIC_ORIGIN=https://hub.example.test

# Orígenes HTTPS públicos usados por el Hub después de autorizar un lanzamiento.
BENEFICIARY_PUBLIC_ORIGIN=https://beneficiary.example.test
SALES_PUBLIC_ORIGIN=https://sales.example.test
COLLECTIONS_PUBLIC_ORIGIN=https://collections.example.test

# Overrides opcionales. Si se omiten, Compose usa estos valores.
# LOGIN_HUB_PORT=3001
# BENEFICIARY_PORT=3002
# SALES_PORT=3003
# COLLECTIONS_PORT=3004
# AUTH_PENDING_TTL_SECONDS=600
# NEXT_PUBLIC_BIOMETRIC_PORT=8899

# docker-compose.prod.yml fija NODE_ENV=production, AUTH_COOKIE_SECURE=true
# y NEXT_PUBLIC_DEPLOY_ENV=prod; no se sobrescriben por variables del ambiente.
